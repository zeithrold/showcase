{
  "name": "showcase",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/check-ui-source.mjs && vite build",
    "start": "wrangler dev --config dist/server/wrangler.json --var SHOWCASE_FRONTEND_ENVIRONMENT:development",
    "deploy": "pnpm build && wrangler deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tooling.json",
    "test": "tsc -p tsconfig.unit.json && node --test .zt/unit/tests/*.test.js",
    "test:e2e": "playwright test",
    "verify:release": "node scripts/verify-release.mjs",
    "lint": "eslint . --max-warnings 0",
    "check": "zt check --module web --profile frontend --root .",
    "lint:css": "ztd-css ./css-check.config.mjs",
    "test:browser": "SHOWCASE_TEST_SUITE=regression playwright test --grep-invert @a11y && pnpm test:preferences",
    "test:a11y": "SHOWCASE_TEST_SUITE=accessibility playwright test --grep @a11y && pnpm test:fonts",
    "test:evidence": "node scripts/verify-evidence.mjs",
    "test:preferences": "playwright test --config playwright.preferences.config.ts",
    "test:fonts": "playwright test --config playwright.fonts.config.ts",
    "check:ui": "node scripts/check-ui-source.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@vinext/cloudflare": "1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "get-nonce": "1.0.1",
    "i18next": "26.4.2",
    "lucide-react": "1.49.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-server-dom-webpack": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "1.1.2",
    "vinext": "1.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "@ztd-me/eslint": "0.1.5",
    "@ztd-me/frontend-checks": "0.1.3",
    "eslint": "10.11.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "wrangler": "4.145.0"
  }
}
