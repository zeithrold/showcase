{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "showcase",
  "account_id": "a0df2e968b524bdd77c0eab565058522",
  "routes": [{ "pattern": "showcase.ztd.me", "custom_domain": true }],
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
